{
  "expo": {
    "name": "Vocabularify",
    "slug": "vocabularify",
    "version": "1.3.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vocabularify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huseyn0w.vocabularify",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.huseyn0w.vocabularify",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F6F7F9"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F9",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#0F1217"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b5aed355-c97a-41ad-a673-114a0a07f2f0"
      }
    },
    "owner": "huseyn0w"
  }
}
